{
  "description": "Pushover notification hooks for interview-plugin",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/stop-pushover.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
